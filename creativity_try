🔹 Code Cell (Core Dashboard Logic)
def interactive_plot(day, min_bill):
    filtered_df = df[
        (df['day'] == day) &
        (df['total_bill'] >= min_bill)
    ]
    
    plt.figure(figsize=(7,5))
    sns.scatterplot(
        data=filtered_df,
        x='total_bill',
        y='tip',
        hue='sex'
    )
    plt.title(f"Tips vs Total Bill on {day}")
    plt.show()

🔹 Add Widgets (THIS IS THE MAGIC ✨)
interact(
    interactive_plot,
    day=widgets.Dropdown(
        options=df['day'].unique(),
        description='Day:'
    ),
    min_bill=widgets.IntSlider(
        min=0,
        max=int(df['total_bill'].max()),
        step=1,
        description='Min Bill:'
    )
)

