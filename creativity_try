3️⃣ Interactive Dashboard: Type + Country + Year Range
def netflix_dashboard(content_type, country, year_range):
    # Filter dataset
    filtered = df[
        (df['type'] == content_type) &
        (df['country'] == country) &
        (df['year_added'] >= year_range[0]) &
        (df['year_added'] <= year_range[1])
    ]
    
    if filtered.empty:
        print("No shows match this selection.")
        return
    
    # 3.1 Top 10 Genres
    genres = filtered['listed_in'].str.split(',', expand=True).stack()
    genre_counts = genres.value_counts().head(10)
    
    plt.figure(figsize=(15,5))
    
    # Genre Barplot
    plt.subplot(1,3,1)
    sns.barplot(x=genre_counts.values, y=genre_counts.index)
    plt.title("Top 10 Genres")
    plt.xlabel("Count")
    
    # 3.2 Ratings Distribution
    plt.subplot(1,3,2)
    rating_counts = filtered['rating'].value_counts().head(10)
    sns.barplot(x=rating_counts.values, y=rating_counts.index, palette="magma")
    plt.title("Top Ratings")
    plt.xlabel("Count")
    
    # 3.3 Timeline of Shows Added
    plt.subplot(1,3,3)
    timeline = filtered['year_added'].value_counts().sort_index()
    sns.lineplot(x=timeline.index, y=timeline.values, marker='o')
    plt.title("Shows Added Over Years")
    plt.xlabel("Year")
    plt.ylabel("Count")
    
    plt.tight_layout()
    plt.show()
    
    print(f"Total shows matching filter: {filtered.shape[0]}")
    print(filtered[['title', 'type', 'country', 'year_added', 'rating']].head(5))

4️⃣ Widgets for Interactivity
# Dropdown for type
type_widget = widgets.Dropdown(
    options=df['type'].unique(),
    description='Type:'
)

# Dropdown for country
country_widget = widgets.Dropdown(
    options=sorted(df['country'].unique()),
    description='Country:'
)

# Year range slider
min_year = int(df['year_added'].min(skipna=True))
max_year = int(df['year_added'].max(skipna=True))

year_widget = widgets.IntRangeSlider(
    value=[min_year, max_year],
    min=min_year,
    max=max_year,
    step=1,
    description='Year Range:'
)

# Combine widgets with dashboard
interact(
    netflix_dashboard,
    content_type=type_widget,
    country=country_widget,
    year_range=year_widget
)

